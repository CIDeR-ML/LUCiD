Bootstrap: docker
From: condaforge/miniforge3:latest

# Base image for the LUCiD unified container. One-time expensive steps:
#   * apt install of the build toolchain
#   * mamba install of GEANT4 11.3 + Python stack (jax + h5py + uproot)
#   * Pythia6 build from source (needed by ROOT 6.28 + GENIE)
#   * ROOT 6.28.12 build from source with -Dpythia6=ON
#
# The top layer (GENIE + PhotonSim + LUCiD) lives in lucid.def. Individual
# build steps are scripts under container/scripts/*.sh so each can be
# re-run inside a sandbox for fast iteration.
#
# Build: `apptainer build --fakeroot lucid-base.sif lucid-base.def`
# Iterate: `apptainer build --sandbox lucid-sandbox/ lucid-base.sif` then
#          `apptainer exec --writable --fakeroot -B /sdf/data/neutrino/cjesus/tmp/build-cache:/build-cache \
#               lucid-sandbox/ bash /opt/container-scripts/build-genie.sh`.

%files
    scripts   /opt/container-scripts

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates git wget curl tar bzip2 xz-utils \
        build-essential gfortran autoconf automake libtool pkg-config \
        libx11-dev libxpm-dev libxft-dev libxext-dev libxml2-dev \
        libssl-dev
    rm -rf /var/lib/apt/lists/*

    mamba install -y -n base -c conda-forge \
        geant4=11.3 \
        python=3.11 \
        cmake make ninja \
        gxx_linux-64=13 gcc_linux-64=13 \
        gsl lhapdf log4cpp libxml2 libxml2-devel pcre zlib \
        jax=0.4 flax optax numpy scipy h5py uproot awkward matplotlib \
        pandas seaborn plotly ipython ipywidgets scikit-learn pillow \
        pytest tqdm pyyaml \
        tbb-devel
    mamba clean -afy

    ln -sf /opt/conda/bin/x86_64-conda-linux-gnu-gcc /opt/conda/bin/gcc
    ln -sf /opt/conda/bin/x86_64-conda-linux-gnu-g++ /opt/conda/bin/g++

    chmod +x /opt/container-scripts/*.sh

    # Only Pythia6 runs here — fast and reliable. ROOT source build
    # happens via `apptainer exec --writable` against the built sandbox
    # (see container/README.md) so that failures don't trash the conda
    # install.
    /opt/container-scripts/build-pythia6.sh

%environment
    export PATH=/opt/root/bin:/opt/conda/bin:$PATH
    export LD_LIBRARY_PATH=/opt/root/lib:/opt/conda/lib:${LD_LIBRARY_PATH:-}
    export ROOTSYS=/opt/root
    export CC=/opt/conda/bin/gcc
    export CXX=/opt/conda/bin/g++

%labels
    Project LUCiD
    Layer base
    Contents "Ubuntu 24.04 + conda GEANT4 11.3 + Pythia6 (source) + ROOT 6.28.12 (source, +pythia6) + jax stack"
