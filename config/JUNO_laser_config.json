{
  "schema_version": 1,
  "detector": "JUNO",
  "wavelength_nm": 532.0,
  "geometry_config": "JUNO_laser_geom_config.json",
  "physics_config": "JUNO_laser_physics_config.json",
  "pmt_positions": "PMTPos_CD_LPMT.csv",
  "materials": {
    "inner": "materials/juno_laser_labls.json",
    "acrylic": "materials/juno_laser_acrylic.json",
    "outer": "materials/juno_laser_water.json"
  },
  "source": {
    "model": "isotropic",
    "default_intensity": 1000000.0
  },
  "transport": {
    "max_scattering_steps": 64,
    "record_trajectories": false,
    "reflection_model": "pmt_surface",
    "wall_reflection_rate": 0.2,
    "sensor_reflection_rate": 0.2,
    "qe": 1.0
  },
  "simulation": {
    "n_photons": 3000000,
    "n_events": 1,
    "max_scattering_steps": 64,
    "record_trajectories": false
  },
  "calibration": {
    "mode": "per_pe",
    "parameters": [
      "scat_ls",
      "abs_ls"
    ],
    "parameter_bounds": {
      "scat_ls": [20.0, 400.0],
      "abs_ls": [50.0, 1200.0]
    },
    "interpolation_sigma_ns": 0.5,
    "time_window_ns": [0.0, 1000.0],
    "time_bin_ns": 0.5,
    "n_photons": 400000,
    "train_ensemble_size": 16,
    "mc_validation_ensemble_size": 16,
    "learning_rate": 0.001,
    "optimizer": "adam",
    "stage_steps": {
      "joint": 64
    },
    "stages": [
      "joint"
    ]
  }
}
