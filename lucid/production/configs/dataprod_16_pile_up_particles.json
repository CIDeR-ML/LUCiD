{
  "config_number": 16,
  "name": "pile-up: mu- + pi+ particle-gun",
  "description": "Two overlapping particle-gun interactions per event: vertex 0 is a mu-, vertex 1 is a pi+. Each vertex draws an independent absolute t0 ~ Uniform(-250, 250) ns and its own fiducial vertex position.",
  "material": "water",
  "pile_up": true,
  "vertices": [
    {
      "primary_source": "particles",
      "energy_distribution": "uniform",
      "particles": [
        {"type": "mu-", "energy_min_MeV": 200, "energy_max_MeV": 2000}
      ]
    },
    {
      "primary_source": "particles",
      "energy_distribution": "uniform",
      "particles": [
        {"type": "pi+", "energy_min_MeV": 200, "energy_max_MeV": 2000}
      ]
    }
  ],
  "store_individual_photons": true,
  "run_lucid": true,
  "disable_decays": false,
  "lucid_options": {
    "apply_smearing": true,
    "apply_translation": true
  },
  "n_jobs": 2,
  "n_events_per_job": 100,
  "cleanup_root_files": true
}
