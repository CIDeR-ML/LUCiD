{
  "config_number": 15,
  "name": "pile-up: (mu- + pi+) + GENIE numu",
  "description": "Two overlapping interactions per event: vertex 0 is a particle-gun (mu- + pi+) shot, vertex 1 is a GENIE numu interaction on water. Each vertex draws an independent absolute interaction time t0 ~ Uniform(-250, 250) ns and its own fiducial vertex position.",
  "material": "water",
  "detector": "HK",
  "digitizer": {
    "model": "hk"
  },
  "selection": {
    "mode": "trigger"
  },
  "trigger": {
    "_note": "HK high-E real trigger \u2014 validated on muons (muon 99.9%, Michel 99.4% hits kept, 0 dark windows) and config_18 pile-up (99.97% physics hits kept, 0 dark windows)",
    "window_ns": 200.0,
    "n_thr": 45,
    "pad_before_ns": 300.0,
    "pad_after_ns": 300.0
  },
  "pile_up": true,
  "vertices": [
    {
      "primary_source": "particles",
      "energy_distribution": "uniform",
      "particles": [
        {
          "type": "mu-",
          "energy_min_MeV": 200,
          "energy_max_MeV": 2000
        },
        {
          "type": "pi+",
          "energy_min_MeV": 200,
          "energy_max_MeV": 2000
        }
      ]
    },
    {
      "primary_source": "genie",
      "genie": {
        "probe_pdg": 14,
        "target": "water",
        "energy_min_GeV": 0.1,
        "energy_max_GeV": 2.0,
        "tune": "G18_10a_02_11b",
        "event_generator_list": "CC+NC",
        "direction": "isotropic"
      }
    }
  ],
  "store_individual_photons": true,
  "run_lucid": true,
  "disable_decays": false,
  "lucid_options": {
    "apply_smearing": true,
    "apply_translation": true
  },
  "n_jobs": 2,
  "n_events_per_job": 100,
  "events_schedule": {
    "events_per_dataset": 10000,
    "target_seconds_per_job": 3600,
    "seconds_per_event": 9.903
  },
  "cleanup_root_files": true
}
