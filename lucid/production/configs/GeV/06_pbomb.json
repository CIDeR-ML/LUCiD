{
  "name": "particle bomb (single vertex)",
  "description": "Single 'particle bomb' interaction per event (no pile-up). Draws a per-event multiplicity N=Uniform(1,5), then samples N particles (with replacement) from the candidate pool {e-, e+, mu-, mu+, pi+, pi-, pi0}. Kinetic energies are uniform in [1, 2000] MeV for electrons and [200, 2000] MeV for the rest, isotropic direction. Same physics as config_18 but with a single vertex.",
  "material": "water",
  "nominal_train": 1000000,
  "nominal_test": 50000,
  "seconds_per_event": 12.0,
  "target_seconds_per_job": 3600,
  "selection": {
    "mode": "trigger"
  },
  "primary_source": "bomb",
  "bomb": {
    "min_particles": 1,
    "max_particles": 5,
    "candidates": [
      {
        "type": "e-",
        "energy_min_MeV": 1,
        "energy_max_MeV": 2000
      },
      {
        "type": "e+",
        "energy_min_MeV": 1,
        "energy_max_MeV": 2000
      },
      {
        "type": "mu-",
        "energy_min_MeV": 200,
        "energy_max_MeV": 2000
      },
      {
        "type": "mu+",
        "energy_min_MeV": 200,
        "energy_max_MeV": 2000
      },
      {
        "type": "pi+",
        "energy_min_MeV": 200,
        "energy_max_MeV": 2000
      },
      {
        "type": "pi-",
        "energy_min_MeV": 200,
        "energy_max_MeV": 2000
      },
      {
        "type": "pi0",
        "energy_min_MeV": 200,
        "energy_max_MeV": 2000
      }
    ]
  },
  "store_individual_photons": true,
  "run_lucid": true,
  "disable_decays": false,
  "lucid_options": {
    "apply_smearing": true,
    "apply_translation": true
  },
  "cleanup_root_files": true
}
