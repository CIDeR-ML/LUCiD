{
  "config_number": 8,
  "name": "e- + pi+",
  "description": "Multi-particle events with electron and positive pion with LUCiD processing",
  "material": "water",
  "detector": "HK",
  "digitizer": {
    "model": "hk"
  },
  "selection": {
    "mode": "trigger"
  },
  "trigger": {
    "_note": "HK high-E real trigger \u2014 validated on muons (muon 99.9%, Michel 99.4% hits kept, 0 dark windows) and config_18 pile-up (99.97% physics hits kept, 0 dark windows)",
    "window_ns": 200.0,
    "n_thr": 45,
    "pad_before_ns": 300.0,
    "pad_after_ns": 300.0
  },
  "energy_distribution": "uniform",
  "store_individual_photons": true,
  "run_lucid": true,
  "disable_decays": false,
  "particles": [
    {
      "type": "e-",
      "energy_min_MeV": 1,
      "energy_max_MeV": 2000
    },
    {
      "type": "pi+",
      "energy_min_MeV": 200,
      "energy_max_MeV": 2000
    }
  ],
  "lucid_options": {
    "apply_smearing": true,
    "apply_translation": true
  },
  "n_jobs": 2,
  "n_events_per_job": 100,
  "events_schedule": {
    "events_per_dataset": 10000,
    "target_seconds_per_job": 3600,
    "seconds_per_event": 8.022
  },
  "cleanup_root_files": true
}
