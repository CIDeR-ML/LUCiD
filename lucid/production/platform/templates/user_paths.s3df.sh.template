#!/bin/bash
# User-specific paths configuration for S3DF — TEMPLATE
# Copy to user_paths.sh and edit. Do NOT commit user_paths.sh.
#
# All production runs go through one `apptainer exec lucid.sif lucid-run-job
# ...` per SLURM job. The unified container ships GEANT4 + ROOT + GENIE +
# PhotonSim + LUCiD, so the only host-side state is the .sif file and the
# output directory.

# =============================================================================
# Cluster identity (read by lucid.production.platform.adapters)
# =============================================================================
# `slurm` (S3DF, NERSC, …) or `htcondor` (LXPLUS). The adapter writes the
# matching submit-description format and uses the matching submit command.
export CLUSTER="slurm"
export CLUSTER_SUBMIT_CMD="sbatch"
# Apptainer bind list (comma-separated) — the shared filesystems each
# `apptainer exec` needs visible inside the container.
export APPTAINER_BINDS="/sdf,/fs,/sdf/scratch,/lscratch,/cvmfs"

# =============================================================================
# Container image
# =============================================================================
# Unified LUCiD container. Pull and convert from ghcr.io with:
#   apptainer pull lucid.sif docker://ghcr.io/cider-ml/lucid:latest
export LUCID_IMAGE_PATH="/path/to/your/lucid.sif"

# =============================================================================
# GENIE cross-section splines
# =============================================================================
# Path *inside* the container. The default points at the `G18_10a_02_11b`
# spline bundled in the LUCiD image (no GENIE dataset config ships today); it
# needs no cvmfs at runtime. To use a different tune, point at
# the matching spline file (mount /cvmfs into the container if it lives
# there).
export GENIE_XSEC_FILE="/opt/genie_xsec/3_04_00/G18_10a_02_11b/gxspl-min.xml.gz"

# =============================================================================
# Output paths
# =============================================================================
# OUTPUT_BASE_PATH: root for the dataset-production stage (dataprod fan-out).
# Files land under <base>/<detector>/[_test/]<block>/[<split>/]config_NN/.
export OUTPUT_BASE_PATH="/path/to/your/production/output"
# SIREN_OUTPUT_BASE_PATH (optional): root for the SIREN-side stages. smax
# fan-out writes under <base>/smax_parametrization/<material>/<particle>/<E>MeV/,
# siren_inputs under <base>/training_inputs/<material>/<particle>/<E>MeV/,
# the t0 fit under <base>/t0_parametrization/<material>/<particle>/,
# train_siren scans under <base>/training_tests/<scan>/. If unset, the stages
# fall back to OUTPUT_BASE_PATH (train_siren to <OUTPUT_BASE_PATH>/training_tests).
#export SIREN_OUTPUT_BASE_PATH="/path/to/your/SIREN_files"

# =============================================================================
# SIREN: existing inputs on S3DF (read-only)
# =============================================================================
# SIREN_INPUTS_BASE_PATH (optional): the tree, laid out like SIREN_OUTPUT_BASE_PATH, from which
# the t0 stage and train_siren configs (${SIREN_INPUTS_BASE_PATH} in h5_path) read earlier
# stages' outputs. Default: SIREN_OUTPUT_BASE_PATH, your own. Uncomment to rerun a stage on the
# inputs of the shipped water emitters (May 2026; another user's files: read them, never write
# there). Under it:
#   smax_parametrization/water/{mu-,e-}/<E>MeV/        stage 0 s_max scans (34 and 61 energies)
#   training_inputs/water/{mu-,e-}/<E>MeV/photonsim.root
#                                                      stage 1 (307 and 339 energies; also the t0
#                                                      inputs)
#   training_inputs/water/lookup_tables/{muon,electron}/{photon,dedx}_lookup_table.h5
#                                                      stage 2 tables (rebuilt 2026-07-01, after the
#                                                      shipped emitters were trained)
#   t0_parametrization/water/mu-/timing_parameters.json
#   t0_parametrization/water/e-/inputs/timing_parameters.json
#                                                      the t0 fits in the shipped emitters
#   training_tests/<scan>/seed<N>/                     the seed scans the shipped emitters came
#                                                      from (emitter.json provenance.run)
# The s_max fits are in PhotonSim itself, data/water/{mu-,e-}/smax_fit.csv.
#export SIREN_INPUTS_BASE_PATH="/sdf/data/neutrino/cjesus/CIDER/SIREN_files"

# =============================================================================
# SLURM configuration
# =============================================================================
# SLURM_PARTITION takes a single partition (e.g. "ampere") or a comma list that
# round-robins jobs across partitions, weighted by an optional :N. For CPU
# dataprod, "roma:130,milano:272" splits jobs by node count to drain faster.
# Keep it single-valued on NERSC/HTCondor (they read one target here).
export SLURM_PARTITION="ampere"
export SLURM_ACCOUNT="your-account:your-group"
# SLURM_QOS (optional): written as --qos into every job. On S3DF an account without a normal
# QOS on a partition (e.g. CPU work on milano or roma) needs "preemptable".
#export SLURM_QOS="preemptable"

# SIREN_TRAIN_PARTITION: the GPU partition train_siren jobs run on (ampere, ada,
# hopper or turing; roma and milano have no GPUs). They charge SLURM_ACCOUNT.
export SIREN_TRAIN_PARTITION="ampere"

# =============================================================================
# Resource defaults
# =============================================================================
export DEFAULT_CPUS="1"
export DEFAULT_MEMORY="39936"   # MB
export DEFAULT_GPUS="1"
export DEFAULT_TIME="23:00:00"

# =============================================================================
# Optional: dev-loop bind mounts
# =============================================================================
# If set, the generators add `-B <path>:/opt/{LUCiD,PhotonSim}` to each
# sbatch's `apptainer exec`, shadowing the baked container copy with your
# host checkout. Useful for validating source-level changes under SLURM
# without rebuilding the container. Leave unset for frozen-container runs.
# The t0 stage and analyze.sh run PhotonSim's tools/ and read its
# data/<material>/<particle>/smax_fit.csv from PHOTONSIM_DEV_PATH, so they need it.
# export LUCID_DEV_PATH="/path/to/your/LUCiD"
# export PHOTONSIM_DEV_PATH="/path/to/your/PhotonSim"

# =============================================================================
# SIREN training: the GPU jaxlib
# =============================================================================
# The image's jaxlib is CPU-only. LUCID_ENV_BASE is a Python user site holding
# the CUDA plugin for the image's jax (0.4.38); train_siren jobs export it as
# PYTHONUSERBASE, and refuse to be written without it. It should hold nothing else:
# the jobs put /opt/LUCiD first on PYTHONPATH so a LUCiD installed there is ignored,
# but other packages in it still shadow the image's. Make one with
#   PYTHONUSERBASE=/path/to/env apptainer exec "$LUCID_IMAGE_PATH" \
#       /opt/conda/bin/python3 -m pip install --user "jax-cuda12-plugin[with_cuda]==0.4.38"
export LUCID_ENV_BASE="/path/to/your/python_env"
