lucid_sim.egg-info/
build/
campaign/grid_out/

# Per-user cluster config (copied from a user_paths.*.sh.template); never commit
lucid/production/platform/user_paths.sh

# Personal dev/research scratch (kept on disk, not tracked)
hessian_probe/
scripts/campaign_recon/
baseline_scripts/
mie_hunter/

# Executed notebooks (rendered copies) — never commit; regenerate or build in CI
*.executed.ipynb
# Generated animations (e.g. tutorials/event.gif from animate_event)
*.gif

# MkDocs build output
site/

# The SIREN emitters' weights (scripts/download_data.py); their emitter.json beside them is
# tracked. After the `!data/**/` negation above, which would
# otherwise re-include them.
data/*/*/*/weights.npz

# Kerberos credential caches. On LXPLUS a stray KRB5CCNAME lands a ccache named
# after the user in whatever directory the job ran from; these hold live tickets
# and must never be committed. Not *.cc — that would mask real C++ sources.
cjesus.cc
krb5cc_*

# Core dumps from crashed batch jobs
core.[0-9]*

# ROOT interpreter history and local build artifacts
.root_hist
*.o
